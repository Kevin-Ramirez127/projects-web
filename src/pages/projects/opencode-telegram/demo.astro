        addPhoneBot(
          `<p class="demo-msg-title">Session finished</p><p class="demo-msg-body">2m 14s · postal-ui</p><p class="demo-msg-body">Moved the sidebar state out of the route component. 148 tests pass.</p>`,
          { label: 'opencode-telegram' },
          myRun,
        );
      }

      async function playQuestion(myRun: number) {
        setComputerStatus('live', 'working');
        setPromptLine('session running');
        await wait(300);
        if (!isActive(myRun)) return;
        addComputerLine('user', 'Add a test for the mute @all setting.', myRun);
