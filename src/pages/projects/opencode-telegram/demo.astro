      async function playFailed(myRun: number) {
        setComputerStatus('live', 'working');
        setPromptLine('session running');
        await wait(300);
        if (!isActive(myRun)) return;
        addComputerLine('user', 'Run the full release build.', myRun);
        await wait(400);
        if (!isActive(myRun)) return;
        addComputerLine('assistant', 'Running the release build.', myRun, { type: true });
        await wait(650);
        if (!isActive(myRun)) return;
        addComputerTool('cargo build --release', '✕ build failed · 48s', myRun, true);
        await wait(350);
        if (!isActive(myRun)) return;
        addComputerError('error[E0308]: mismatched types', 'expected `String`, found `&str` · crates/postal-core/src/store/chats.rs:184', myRun);
        await wait(350);
        if (!isActive(myRun)) return;
        addComputerLine('status', 'session failed · 48s', myRun);
        setComputerStatus('failed', 'failed');
        setPromptLine('session failed', false);
        setStageStatus('failed', 'failed');
        showNotification('Session failed', 'cargo build --release — mismatched types');
        await wait(400);
        if (!isActive(myRun)) return;
        await showTyping(myRun, 600);
        if (!isActive(myRun)) return;
        const { buttons } = addPhoneBot(
          `<p class="demo-msg-title">Session failed</p><p class="demo-msg-body">The release build failed after 48s.</p><code class="demo-msg-code">error[E0308]: mismatched types</code>`,
          {
            label: 'opencode-telegram',
            actions: [{ label: 'Show error tail', value: 'show error tail' }],
          },
          myRun,
        );
        const choice = await waitForChoice(buttons, myRun);
        if (!isActive(myRun)) return;
        addPhoneUser(choice === 'show error tail' ? 'Show error tail' : choice, myRun);
        await wait(250);
        if (!isActive(myRun)) return;
        addPhoneBot(
          `<p class="demo-msg-body">expected <code>String</code>, found <code>&amp;str</code></p><p class="demo-msg-body">at crates/postal-core/src/store/chats.rs:184</p>`,
          {},
          myRun,
        );
      }

      async function runScenario(id: string, initial = false) {
        started = true;
        currentScenario = id;
        const myRun = ++runId;
        const activeButton = scenarioButtons.find((button) => button.dataset.scenario === id);
        scenarioButtons.forEach((button) => {
          const active = button === activeButton;
          button.dataset.active = String(active);
          button.setAttribute('aria-pressed', String(active));
        });

        const number = activeButton?.querySelector('.demo-scenario-number')?.textContent ?? '01';
        const label = activeButton?.querySelector('.demo-scenario-title')?.textContent ?? id;
        caption.textContent = `${number} / ${label}`;

        if (!initial) {
          const rect = stage.getBoundingClientRect();
          if (rect.top < 80 || rect.bottom > window.innerHeight) {
            stage.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          }
        }

        resetStage();
        if (!initial) {
          play(computerFeed, { opacity: [0.35, 1], y: [4, 0] }, { duration: 0.25, ease: MOTION.ease.out });
          play(phoneFeed, { opacity: [0.35, 1], y: [4, 0] }, { duration: 0.25, ease: MOTION.ease.out });
        }
        setStageStatus('live', 'running');
        await wait(initial ? 450 : 220);
        if (!isActive(myRun)) return;

        addComputerLine('status', 'session postal-ui · connected', myRun, { instant: true });
        addPhoneSystem('connected · listening for events', myRun);

        let endTone = 'done';
        let endLabel = 'complete';

        switch (id) {
          case 'question':
            await playQuestion(myRun);
            break;
          case 'permission': {
            const approved = await playPermission(myRun);
            if (!approved) {
              endTone = 'idle';
              endLabel = 'stopped';
            }
            break;
          }
          case 'prompt':
            await playPrompt(myRun);
            break;
          case 'failed':
            endTone = 'failed';
            endLabel = 'failed';
            await playFailed(myRun);
            break;
          case 'finished':
          default:
            await playFinished(myRun);
            break;
        }

        if (isActive(myRun)) {
          setStageStatus(endTone, endLabel);
        }
      }

      scenarioButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.scenario;
          if (id) void runScenario(id);
        });
      });

      replay.addEventListener('click', () => {
        void runScenario(currentScenario);
      });

      inView(
        stage,
        () => {
          if (started) return;
          started = true;
          void runScenario('finished', true);
        },
        { margin: MOTION.viewport.margin },
      );
  </script>
</BaseLayout>
