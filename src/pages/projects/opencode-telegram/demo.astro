        setStageStatus('live', 'working');
        await wait(250);
        if (!isActive(myRun)) return;
        addComputerLine('assistant', `Using ${choice}. Writing the migration now.`, myRun, { type: true });
        await wait(750);
        if (!isActive(myRun)) return;
        addComputerTool('cargo test', '✓ 3 tests added · 151 passed', myRun);
        await wait(350);
        if (!isActive(myRun)) return;
        addComputerLine('status', 'session finished · 1m 42s', myRun);
