      async function playPermission(myRun: number): Promise<boolean> {
        setComputerStatus('live', 'working');
        setPromptLine('session running');
        await wait(300);
        if (!isActive(myRun)) return false;
        addComputerLine('user', 'Push the fix to the branch.', myRun);
        await wait(400);
        if (!isActive(myRun)) return false;
        addComputerLine('assistant', 'The fix is committed. I need permission to push.', myRun, { type: true });
        await wait(850);
        if (!isActive(myRun)) return false;
        addComputerPanel(
          { label: 'PERMISSION', title: 'Allow this command?', code: 'git push origin fix/sidebar-state' },
          myRun,
        );
        setComputerStatus('waiting', 'waiting');
        setPromptLine('waiting for you');
        setStageStatus('waiting', 'waiting for you');
        showNotification('Permission requested', 'git push origin fix/sidebar-state');
        await wait(400);
        if (!isActive(myRun)) return false;
        await showTyping(myRun, 600);
        if (!isActive(myRun)) return false;
        const { buttons } = addPhoneBot(
          `<p class="demo-msg-title">Permission requested</p><p class="demo-msg-body">I want to run:</p><code class="demo-msg-code">git push origin fix/sidebar-state</code>`,
          {
            label: 'opencode-telegram',
            actions: [
              { label: 'Approve', value: 'approve' },
              { label: 'Deny', value: 'deny' },
            ],
          },
          myRun,
        );
        const choice = await waitForChoice(buttons, myRun);
        if (!isActive(myRun)) return false;

        if (choice === 'approve') {
          addPhoneUser('Approved', myRun);
          markPanelChoice('approved by telegram');
          setComputerStatus('live', 'working');
          setPromptLine('session running');
          setStageStatus('live', 'working');
          await wait(250);
          if (!isActive(myRun)) return false;
          addComputerLine('assistant', 'Permission granted. Pushing now.', myRun, { type: true });
          await wait(550);
          if (!isActive(myRun)) return false;
          addComputerTool('git push origin fix/sidebar-state', '✓ pushed · 12 files', myRun);
          await wait(350);
          if (!isActive(myRun)) return false;
          addComputerLine('status', 'session finished · 38s', myRun);
          setComputerStatus('done', 'finished');
          setPromptLine('session finished');
          showNotification('Session finished', 'Pushed fix/sidebar-state — 12 files');
          await wait(350);
          if (!isActive(myRun)) return false;
          addPhoneBot(
            `<p class="demo-msg-title">Pushed.</p><p class="demo-msg-body">fix/sidebar-state is up to date. Session finished in 38s.</p>`,
            {},
            myRun,
          );
          return true;
        } else {
          addPhoneUser('Denied', myRun);
          markPanelChoice('denied by telegram');
          setComputerStatus('idle', 'stopped');
          setPromptLine('permission denied', false);
          setStageStatus('idle', 'stopped');
          await wait(250);
          if (!isActive(myRun)) return false;
          addComputerLine('assistant', 'Understood. I will not push. The session is stopped.', myRun, { type: true });
          await wait(600);
          if (!isActive(myRun)) return false;
          addComputerLine('status', 'permission denied · session stopped', myRun);
          await showTyping(myRun, 500);
          if (!isActive(myRun)) return false;
          addPhoneBot(
            `<p class="demo-msg-title">Denied.</p><p class="demo-msg-body">Understood. I won't push. The session is stopped.</p>`,
            {},
            myRun,
          );
          return false;
        }
      }

      async function playPrompt(myRun: number) {
        setComputerStatus('idle', 'idle');
