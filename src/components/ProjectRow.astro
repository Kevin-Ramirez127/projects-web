---
import BracketLink from './BracketLink.astro';
import { projectPath, type Project } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const source = project.links.find((link) => link.label === 'Source');
---
<article class="group border-b hairline transition-colors hover:border-accent/40">
  <div class="grid gap-5 py-9 md:grid-cols-[3.5rem_minmax(0,1fr)] md:gap-8 md:py-11">
    <div class="flex items-center gap-3 md:block md:pt-2">
      <span class="font-matrix text-[11px] tracking-[0.3em] text-bone-faint">{String(index + 1).padStart(2, '0')}</span>
      {project.featured && (
        <span class="md:mt-3 md:inline-block font-matrix text-[9px] tracking-[0.2em] text-accent border border-accent/30 px-2 py-1">FLAGSHIP</span>
      )}
    </div>

    <div class="max-w-3xl">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
        <h3 class="text-3xl md:text-[40px] font-extralight leading-none tracking-tight">
          <a href={projectPath(project.slug)} class="transition-colors group-hover:text-accent">{project.name}</a>
        </h3>
        <span class="font-matrix text-[10px] tracking-[0.16em] text-bone-faint border hairline px-2 py-1">{project.meta}</span>
      </div>
      <p class="mt-4 max-w-2xl text-bone/85 font-light leading-relaxed">{project.summary}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-4">
        <div class="flex flex-wrap gap-2">
          {project.stack.map((tag) => (
            <span class="font-matrix text-[11px] border hairline px-2.5 py-1 text-bone-dim">{tag}</span>
          ))}
        </div>
        <div class="flex items-center gap-6">
          <BracketLink href={projectPath(project.slug)} label="case study" size="text-lg" />
          {source && (
            <a
              href={source.href}
              target={source.external ? '_blank' : undefined}
              rel={source.external ? 'noreferrer' : undefined}
              class="font-matrix text-[11px] tracking-widest text-bone-faint hover:text-accent transition-colors"
            >
              source ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</article>
