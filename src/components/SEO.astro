---
import { buildSeoPayload, validatePayload } from '@easeo/core';
import { site } from '../lib/site';
import { seoConfig } from '../lib/seo-config.mjs';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  image,
  noindex = false,
  type = 'website',
  jsonLd = [],
} = Astro.props;

const entityType = path === '/' ? 'home' : type === 'article' ? 'post' : 'page';
const base = Astro.site ?? new URL(site.url);
const ogImage = new URL(image ?? seoConfig.defaultOgImage, base).toString();
// The shared cover is the main site's identity card, so describe that.
const ogImageAlt = 'Kevin Ramirez — Full-stack developer & toolmaker';

const payload = buildSeoPayload(
  {
    entityType,
    title,
    description,
    image: ogImage,
    imageWidth: 1200,
    imageHeight: 630,
    imageAlt: ogImageAlt,
    authorName: site.author,
  },
  path,
  seoConfig,
  noindex
    ? { robotsIndex: false, robotsFollow: false }
    : { robotsIndex: true, robotsFollow: true, robotsMaxImagePreview: 'large' },
);

// Fail the build on real SEO regressions; warnings stay non-blocking.
const seoErrors = validatePayload(payload).filter((issue) => issue.severity === 'error');
if (seoErrors.length > 0) {
  throw new Error(`SEO validation failed: ${seoErrors.map((issue) => issue.ruleId).join(', ')}`);
}

const personUrl = site.social.portfolio;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  // Same @id as the main site so both properties describe one person entity.
  // Keep this node minimal: the main site owns the richer profile.
  '@id': `${personUrl}/#person`,
  name: site.name,
  url: personUrl,
  sameAs: [site.social.github, site.social.linkedin],
};
---

{/* Title, description, canonical, robots, Open Graph, Twitter Cards and JSON-LD. */}
<Fragment set:html={payload.renderHtml()} />
<meta name="keywords" content={site.keywords.join(', ')} />
<meta name="author" content={site.author} />
<meta name="theme-color" content={site.themeColor} />
<meta name="color-scheme" content="light dark" />
<meta name="generator" content={Astro.generator} />

{/* Icons (no web manifest: keeps browsers from offering an app install) */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />

{/* Self-hosted fonts: preload the two LCP-critical faces. */}
<link rel="preload" href="/fonts/raleway-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

{/* Person entity, linked to the WebSite schema generated by easeo. */}
<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
{jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
