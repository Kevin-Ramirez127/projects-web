---
import TelegramPlane from './TelegramPlane.astro';
import OpenCodeWordmark from './OpenCodeWordmark.astro';
import OpenCodeLogo from './OpenCodeLogo.astro';
import '../styles/demo.css';

const scenarios = [
  {
    id: 'finished',
    number: '01',
    title: 'Session finished',
    description: 'A completed run lands on your phone.',
  },
  {
    id: 'question',
    number: '02',
    title: 'Agent question',
    description: 'The agent stops for a decision. You answer from Telegram.',
  },
  {
    id: 'permission',
    number: '03',
    title: 'Permission request',
    description: 'Approve or deny a tool call without opening the terminal.',
  },
  {
    id: 'prompt',
    number: '04',
    title: 'Prompt from Telegram',
    description: 'Send a new instruction to the bound session.',
  },
  {
    id: 'commands',
    number: '05',
    title: 'Bot commands',
    description: 'Tap the pulsing Menu button and run a command.',
  },
];

const phoneCommands = [
  { id: 'session', command: '/session', description: 'Pick one of the recent sessions.' },
  { id: 'settings', command: '/settings', description: 'Show notification settings.' },
  { id: 'exit', command: '/exit', description: 'Stop the Telegram daemon.' },
  { id: 'agents', command: '/agents', description: 'Switch the bound session agent.' },
  { id: 'models', command: '/models', description: 'Choose a chat model.' },
  { id: 'usage', command: '/usage', description: 'Show OpenCode usage limits.' },
];
---

<div
  id="demo-stage"
  class="reveal demo-shell scroll-mt-24 border hairline bg-ink-soft/40 p-3 md:p-5"
  role="region"
  aria-label="OpenCode and Telegram simulation"
>
  <div class="demo-toolbar">
    <div>
      <p class="font-matrix text-[9px] tracking-[0.22em] text-bone-faint">...LIVE SIMULATION...</p>
      <p id="demo-caption" class="mt-1 font-matrix text-[11px] tracking-[0.16em] text-bone" aria-live="polite">01 / Session finished</p>
    </div>
    <div class="flex items-center gap-4">
      <span id="demo-stage-status" class="demo-stage-status" data-tone="live" aria-live="polite"><span class="demo-live-dot"></span> running</span>
      <button id="demo-replay" type="button" class="demo-replay">[ replay ]</button>
    </div>
  </div>

  <div class="demo-devices mt-4">
    {/* Computer — OpenCode TUI */}
    <div class="oc-console order-2">
      <div id="demo-computer" class="oc-window">
        <div class="oc-titlebar">
          <div class="oc-titlebar-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span class="oc-titlebar-path">opencode — ~/projects/postal</span>
        </div>

        <div class="oc-screen">
          <div class="oc-header">
            <OpenCodeWordmark class="oc-wordmark" />
            <div class="oc-header-meta">
              <span class="oc-session">postal-ui</span>
            </div>
          </div>

          <div id="computer-feed" class="oc-feed">
            <p class="oc-line oc-line--status"><span class="oc-glyph">·</span><span>enable JavaScript to run the simulation</span></p>
          </div>

          <div class="oc-composer">
            <div class="oc-composer-input">
              <span class="oc-chevron">❯</span>
              <span id="computer-prompt" class="oc-caret" aria-hidden="true"></span>
            </div>
            <div class="oc-composer-footer">
              <span class="oc-agent">Build</span>
              <span class="oc-sep">·</span>
              <span class="oc-model-name">Big Pickle</span>
              <span class="oc-brand">OpenCode</span>
            </div>
          </div>

          <div class="oc-statusbar">
            <span>~/projects/postal</span>
            <span class="oc-shortcuts">
              <span class="oc-telegram"><TelegramPlane class="oc-telegram-icon" /> Telegram on</span>
              <span>shift+tab agents</span>
              <span>ctrl+p commands</span>
            </span>
          </div>
        </div>
      </div>

      <div id="computer-status" class="oc-session-status" data-tone="idle">
        <span class="oc-status-dot"></span> session idle
      </div>
    </div>

    {/* Phone — Telegram */}
    <div id="demo-phone" class="tg-phone order-1">
      <div class="tg-screen">
        <div class="tg-camera" aria-hidden="true"></div>
        <div class="tg-statusbar">
          <span class="tg-time">09:41</span>
          <div class="tg-status-icons" aria-hidden="true">
            <svg width="13" height="10" viewBox="0 0 13 10" fill="currentColor"><rect x="0" y="7" width="2" height="3" rx=".5" /><rect x="3.5" y="5" width="2" height="5" rx=".5" /><rect x="7" y="3" width="2" height="7" rx=".5" /><rect x="10.5" y="0" width="2" height="10" rx=".5" /></svg>
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M1 3.5a9 9 0 0 1 12 0" /><path d="M3.5 6a5.5 5.5 0 0 1 7 0" /><circle cx="7" cy="8.5" r=".8" fill="currentColor" stroke="none" /></svg>
            <svg width="18" height="9" viewBox="0 0 18 9" fill="none" stroke="currentColor"><rect x=".5" y=".5" width="15" height="8" rx="2" /><rect x="2" y="2" width="10" height="5" rx="1" fill="currentColor" stroke="none" /><path d="M17 3v3" stroke-width="2" stroke-linecap="round" /></svg>
          </div>
        </div>

        <div class="tg-header">
          <svg class="tg-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          <div class="tg-avatar"><OpenCodeLogo idPrefix="tg-avatar-logo" /></div>
          <div class="tg-header-info">
            <p class="tg-chat-name">opencode-telegram</p>
            <p class="tg-chat-status">bot</p>
          </div>
          <span class="tg-more" aria-hidden="true">⋯</span>
        </div>

        <div id="phone-feed" class="tg-feed">
          <div class="demo-msg demo-msg--system">enable JavaScript to run the simulation</div>
        </div>

        <div id="phone-composer" class="tg-composer">
          <button id="tg-menu-btn" class="tg-menu-btn" type="button" aria-expanded="false" aria-controls="tg-command-menu" disabled>
            <svg class="tg-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <span>Menu</span>
          </button>
          <svg class="tg-composer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8.5 14.5s1.2 1.8 3.5 1.8 3.5-1.8 3.5-1.8" /><path d="M9 9.5h.01M15 9.5h.01" stroke-width="2.2" /></svg>
          <input id="phone-input" type="text" disabled placeholder="Message" aria-label="Message the agent" autocomplete="off" />
          <svg class="tg-composer-attach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 11.5-8.5 8.5a5 5 0 0 1-7-7L14 4.5a3.5 3.5 0 0 1 5 5L10 18.5a2 2 0 0 1-3-3l8-8" /></svg>
          <button id="phone-send" type="button" disabled aria-label="Send message">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.7 2.3a1 1 0 0 0-1.1-.2L2.6 9.6a1 1 0 0 0 .1 1.9l7.1 2.1 2.1 7.1a1 1 0 0 0 1.9.1l8-17.6a1 1 0 0 0-.1-1Z" /></svg>
          </button>
        </div>

        <div id="tg-command-backdrop" class="tg-command-backdrop" aria-hidden="true"></div>
        <div id="tg-command-menu" class="tg-command-menu" aria-hidden="true" inert>
          <div class="tg-command-handle" aria-hidden="true"></div>
          <div class="tg-command-head">
            <span class="tg-command-title">Menu</span>
            <button id="tg-command-close" class="tg-command-close" type="button" aria-label="Close menu">×</button>
          </div>
          <div class="tg-command-list" role="menu" aria-label="Bot commands">
            {phoneCommands.map((command) => (
              <button type="button" class="tg-command-item" data-command={command.id} role="menuitem">
                <span class="tg-command-name">{command.command}</span>
                <span class="tg-command-desc">{command.description}</span>
              </button>
            ))}
          </div>
        </div>

        <div id="tg-reset-tooltip" class="tg-reset-tooltip" aria-hidden="true" inert>
          <p class="tg-reset-text">opencode-telegram daemon stopped.</p>
          <button id="tg-reset-demo" class="tg-reset-btn" type="button">Reset demo</button>
        </div>

        <div id="phone-notification" class="demo-notification" role="status" aria-live="polite">
          <div class="tg-notification-icon"><OpenCodeLogo idPrefix="tg-notification-logo" /></div>
          <div class="min-w-0">
            <p class="demo-notification-meta">opencode-telegram · now</p>
            <p id="notif-title" class="demo-notification-title">Session finished</p>
            <p id="notif-body" class="demo-notification-body">A completed run lands on your phone.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{/* Scenario menu */}
<div class="reveal mt-10">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="font-matrix text-[10px] tracking-[0.25em] text-bone-faint">...CHOOSE AN INTERACTION...</p>
      <h3 class="mt-2 text-2xl md:text-3xl font-extralight tracking-tight">Try a scenario</h3>
    </div>
    <p class="max-w-xs text-xs leading-relaxed text-bone-faint font-light">
      The phone is live. Click the buttons inside the chat when a scenario asks you to.
    </p>
  </div>

  <div class="mt-6 grid gap-px bg-line border hairline sm:grid-cols-2 lg:grid-cols-3" role="group" aria-label="Demo scenarios">
    {scenarios.map((scenario, index) => (
      <button
        type="button"
        class="demo-scenario bg-ink p-5 text-left cursor-pointer"
        data-scenario={scenario.id}
        data-active={index === 0 ? 'true' : 'false'}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        <span class="demo-scenario-title">{scenario.title}</span>
        <span class="demo-scenario-desc">{scenario.description}</span>
      </button>
    ))}

    <a
      href="https://github.com/Kevin-Ramirez127/opencode-telegram"
      target="_blank"
      rel="noreferrer"
      class="demo-scenario group bg-ink p-5 text-left"
      aria-label="View the opencode-telegram source on GitHub"
    >
w      <span class="mt-[0.6rem] flex items-center gap-3">
        <svg class="h-5 w-5 shrink-0 text-bone transition-colors group-hover:text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.17c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.4-5.25 5.69.41.35.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
        </svg>
        <span class="text-[1.15rem] font-light leading-tight text-bone transition-colors group-hover:text-accent">GitHub</span>
        <span class="ml-auto text-accent" aria-hidden="true">↗</span>
      </span>
      <span class="demo-scenario-desc">Source, issues and releases.</span>
    </a>
  </div>
  <p class="mt-4 max-w-3xl text-[11px] leading-relaxed text-bone-faint font-light">
    Simulation only. In the real daemon, notifications are off by default, and prompting or custom answers are opt-in.
  </p>
</div>

{/* Architecture strip */}
<div class="reveal mt-14">
  <p class="font-matrix text-[10px] tracking-[0.25em] text-bone-faint">...WHAT YOU ARE WATCHING...</p>
  <div class="mt-5 grid gap-px bg-line border hairline sm:grid-cols-3">
    <div class="bg-ink p-5 md:p-6">
      <div class="flex items-center gap-3 text-accent">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="3" />
          <path d="m8 9 3 3-3 3" />
          <path d="M13 15h3" />
        </svg>
        <span class="font-matrix text-[10px] tracking-[0.18em]">01 / OPENCODE</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-bone/85 font-light">
        The session emits SSE events: finished, failed, questions, permissions and retries.
      </p>
    </div>
    <div class="bg-ink p-5 md:p-6">
      <div class="flex items-center gap-3 text-accent">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3 20 6v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3Z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        <span class="font-matrix text-[10px] tracking-[0.18em]">02 / DAEMON</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-bone/85 font-light">
        The Go daemon filters events through the allowlist and turns the ones that need you into messages.
      </p>
    </div>
    <div class="bg-ink p-5 md:p-6">
      <div class="flex items-center gap-3 text-accent">
        <TelegramPlane class="h-5 w-5" />
        <span class="font-matrix text-[10px] tracking-[0.18em]">03 / TELEGRAM</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-bone/85 font-light">
        Your allowlisted chat gets the notification. When you answer, the decision travels back to the session.
      </p>
    </div>
  </div>
</div>

  <script>
    import { animate, inView } from 'motion';
    import { MOTION } from '../lib/motion-config.ts';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const byId = <T extends HTMLElement>(id: string): T => {
      const element = document.getElementById(id);
      if (!element) throw new Error(`Missing #${id}`);
      return element as T;
    };

    const stage = byId<HTMLElement>('demo-stage');
    const computerFeed = byId<HTMLElement>('computer-feed');
    const phoneFeed = byId<HTMLElement>('phone-feed');
    const commandMenu = byId<HTMLElement>('tg-command-menu');
    const commandBackdrop = byId<HTMLElement>('tg-command-backdrop');
    const commandMenuBtn = byId<HTMLButtonElement>('tg-menu-btn');
    const commandClose = byId<HTMLButtonElement>('tg-command-close');
    const commandItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.tg-command-item'));
    const resetTooltip = byId<HTMLElement>('tg-reset-tooltip');
    const resetDemoBtn = byId<HTMLButtonElement>('tg-reset-demo');
    const computerStatus = byId<HTMLElement>('computer-status');
    const stageStatus = byId<HTMLElement>('demo-stage-status');
    const caption = byId<HTMLElement>('demo-caption');
    const phoneInput = byId<HTMLInputElement>('phone-input');
    const phoneSend = byId<HTMLButtonElement>('phone-send');
    const phoneComposer = byId<HTMLElement>('phone-composer');
    const notification = byId<HTMLElement>('phone-notification');
    const notifTitle = byId<HTMLElement>('notif-title');
    const notifBody = byId<HTMLElement>('notif-body');
    const replay = byId<HTMLButtonElement>('demo-replay');
    const scenarioButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.demo-scenario'));

    const sleep = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));
      const wait = (ms: number) => sleep(reduceMotion ? Math.min(ms, 120) : ms);

      const play = (el: Element | Element[], keyframes: any, options: any) => {
        if (reduceMotion) return;
        try {
          animate(el, keyframes, options);
        } catch {}
      };

      const playAndWait = async (el: Element | Element[], keyframes: any, options: any) => {
        if (reduceMotion) return;
        try {
          await animate(el, keyframes, options).finished;
        } catch {}
      };

      let runId = 0;
      let started = false;
      let currentScenario = 'finished';
      let pendingPrompt: ((value: string) => void) | null = null;
      let pendingCommandSelection: ((value: string) => void) | null = null;
      let commandMenuOpen = false;
      let daemonStopped = false;
      let commandsHintShown = false;
      let boundSession = '';
      let notificationTimer: number | undefined;

      const isActive = (id: number) => id === runId;
      const esc = (value: string) =>
        value.replace(/[&<>"']/g, (character) => {
          const map: Record<string, string> = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          };
          return map[character] ?? character;
        });

      const SESSIONS = [
        { title: 'postal-ui', directory: '~/projects/postal' },
        { title: 'gitsion', directory: '~/projects/gitsion' },
        { title: 'quick-bitwarden', directory: '~/projects/quick-bitwarden' },
      ];

      const COMMANDS: Record<
        string,
        {
          command: string;
          html: string;
          actions?: { label: string; value: string }[];
          followUp?: (label: string, value: string) => string;
        }
      > = {
        session: {
          command: '/session',
          html: '<p class="demo-msg-title">Recent sessions</p><p class="demo-msg-body">Tap a session to bind it.</p>',
          actions: SESSIONS.map((session) => ({ label: session.title, value: session.title })),
          followUp: (label) => {
            const session = SESSIONS.find((entry) => entry.title === label);
            return `🔗 Bound to: ${label}${session ? ` · ${session.directory}` : ''}.`;
          },
        },
        settings: {
          command: '/settings',
          html: '<p class="demo-msg-title">Notification settings</p><p class="demo-msg-body">Enabled: on<br>Session finished: on<br>Session failed: on<br>Question asked: on<br>Permission asked: on</p>',
        },
        exit: {
          command: '/exit',
          html: '<p class="demo-msg-title">Stop daemon?</p><p class="demo-msg-body">OpenCode keeps running; only the Telegram notifier stops.</p>',
          actions: [
            { label: 'Stop daemon', value: 'stop daemon' },
            { label: 'Cancel', value: 'cancel' },
          ],
          followUp: (_label, value) =>
            value === 'stop daemon' ? '✅ opencode-telegram daemon stopped.' : 'Cancelled.',
        },
        agents: {
          command: '/agents',
          html: '<p class="demo-msg-title">Agents for postal-ui</p><p class="demo-msg-body">Current: build</p>',
          actions: [
            { label: '✓ Build', value: 'build' },
            { label: 'Plan', value: 'plan' },
            { label: 'General', value: 'general' },
          ],
          followUp: (label) => `Agent switched to ${label}.`,
        },
        models: {
          command: '/models',
          html: '<p class="demo-msg-title">Available models (3)</p><p class="demo-msg-body">Current: Big Pickle</p>',
          actions: [
            { label: '✓ Big Pickle', value: 'big pickle' },
            { label: 'GPT-5.1 Codex', value: 'gpt-5.1-codex' },
            { label: 'Claude Sonnet 4.5', value: 'claude-sonnet-4.5' },
          ],
          followUp: (label) => `Model switched to ${label}.`,
        },
        usage: {
          command: '/usage',
          html: '<p class="demo-msg-title">OpenCode usage limits</p><p class="demo-msg-body">Workspace: OpenCode Console<br>Go · Rolling 42% · Weekly 18% · Monthly 9%<br>Console budget: $12.40 / $50</p>',
        },
      };

      const scrollFeed = (feed: HTMLElement) => {
        feed.scrollTop = feed.scrollHeight;
      };

      const setCommandMenu = (open: boolean, moveFocus = true) => {
        if (open && (commandMenuBtn.disabled || currentScenario !== 'commands')) return;
        commandMenuOpen = open;
        commandMenu.classList.toggle('is-open', open);
        commandBackdrop.classList.toggle('is-open', open);
        commandMenu.setAttribute('aria-hidden', String(!open));
        commandMenu.inert = !open;
        commandMenuBtn.setAttribute('aria-expanded', String(open));
        if (open) commandMenuBtn.classList.remove('is-attention');
        if (moveFocus) {
          if (open) commandItems[0]?.focus();
          else commandMenuBtn.focus();
        }
      };

      const setResetTooltip = (open: boolean) => {
        resetTooltip.classList.toggle('is-open', open);
        resetTooltip.setAttribute('aria-hidden', String(!open));
        resetTooltip.inert = !open;
      };

      const setComputerStatus = (tone: string, text: string) => {
        computerStatus.dataset.tone = tone;
        computerStatus.innerHTML = `<span class="oc-status-dot"></span> ${esc(text)}`;
      };

      const setStageStatus = (tone: string, text: string) => {
        stageStatus.dataset.tone = tone;
        stageStatus.innerHTML = `<span class="demo-live-dot"></span> ${esc(text)}`;
      };

      const setComposer = (enabled: boolean, value = '', readOnly = false) => {
        phoneInput.disabled = !enabled;
        phoneInput.readOnly = enabled && readOnly;
        phoneSend.disabled = !enabled;
        phoneInput.placeholder = 'Message';
        phoneInput.value = value;
        phoneComposer.classList.toggle('is-live', enabled);
      };

      const showNotification = (title: string, body: string) => {
        if (notificationTimer) window.clearTimeout(notificationTimer);
        notifTitle.textContent = title;
        notifBody.textContent = body;
        notification.classList.add('is-show');
        notificationTimer = window.setTimeout(
          () => notification.classList.remove('is-show'),
          reduceMotion ? 1400 : 2600,
        );
      };

      function resetStage() {
        pendingPrompt = null;
        pendingCommandSelection = null;
        boundSession = '';
        commandMenuBtn.classList.remove('is-attention');
        phoneSend.classList.remove('is-attention');
        commandMenuBtn.disabled = currentScenario !== 'commands' || daemonStopped;
        commandMenuBtn.classList.toggle('is-command-scenario', currentScenario === 'commands');
        setCommandMenu(false, false);
        setResetTooltip(false);
        if (notificationTimer) window.clearTimeout(notificationTimer);
        notification.classList.remove('is-show');
        computerFeed.innerHTML = '';
        phoneFeed.innerHTML = '';
        setComposer(false);
        setComputerStatus('idle', 'session idle');
        setStageStatus('live', 'running');
      }

      function addComputerLine(
        kind: 'user' | 'assistant' | 'tool' | 'status' | 'error',
        text: string,
        myRun: number,
        options: { type?: boolean; instant?: boolean } = {},
      ) {
        if (!isActive(myRun)) return;
        const line = document.createElement('div');
        line.className = `oc-line oc-line--${kind}`;
        const glyph = document.createElement('span');
        glyph.className = 'oc-glyph';
        glyph.textContent = kind === 'user' ? '›' : kind === 'assistant' ? '●' : kind === 'tool' ? '▸' : kind === 'error' ? '!' : '·';
        const body = document.createElement('div');
        body.className = 'min-w-0';
        if (!options.type) body.textContent = text;
        line.append(glyph, body);
        computerFeed.append(line);
        scrollFeed(computerFeed);
        if (!options.instant) play(line, { opacity: [0, 1], y: [6, 0] }, { duration: MOTION.duration.fast, ease: MOTION.ease.out });
        if (options.type) void typeText(body, text, myRun);
      }

      async function typeText(element: HTMLElement, text: string, myRun: number) {
        if (reduceMotion) {
          element.textContent = text;
          return;
        }
        element.classList.add('oc-caret');
        const words = text.split(' ');
        element.textContent = '';
        for (let index = 0; index < words.length; index += 1) {
          if (!isActive(myRun)) {
            element.classList.remove('oc-caret');
            return;
          }
          element.textContent += `${index === 0 ? '' : ' '}${words[index]}`;
          scrollFeed(computerFeed);
          await sleep(words[index].length > 6 ? 44 : 28);
        }
        element.classList.remove('oc-caret');
      }

      function addComputerTool(command: string, result: string, myRun: number, failed = false) {
        if (!isActive(myRun)) return;
        const line = document.createElement('div');
        line.className = 'oc-line oc-line--tool';
        const glyph = document.createElement('span');
        glyph.className = 'oc-glyph';
        glyph.textContent = '▸';
        const body = document.createElement('div');
        body.className = 'min-w-0';
        const commandLine = document.createElement('div');
        const label = document.createElement('strong');
        label.textContent = 'bash';
        const code = document.createElement('code');
        code.textContent = command;
        commandLine.append(label, document.createTextNode(' '), code);
        const resultLine = document.createElement('div');
        resultLine.className = 'oc-tool-result';
        resultLine.textContent = result;
        if (failed) resultLine.style.color = 'var(--color-bone)';
        body.append(commandLine, resultLine);
        line.append(glyph, body);
        computerFeed.append(line);
        scrollFeed(computerFeed);
        play(line, { opacity: [0, 1], y: [6, 0] }, { duration: MOTION.duration.fast, ease: MOTION.ease.out });
      }

      function addComputerPanel(
        panelData: { label: string; title: string; code?: string; options?: string[] },
        myRun: number,
      ) {
        if (!isActive(myRun)) return null;
        const panel = document.createElement('div');
        panel.className = 'oc-panel';
        const label = document.createElement('p');
        label.className = 'oc-panel-label';
        label.textContent = panelData.label;
        const title = document.createElement('p');
        title.className = 'oc-panel-title';
        title.textContent = panelData.title;
        panel.append(label, title);

        if (panelData.code) {
          const code = document.createElement('code');
          code.className = 'oc-code mt-2 inline-block';
          code.textContent = panelData.code;
          panel.append(code);
        }

        if (panelData.options) {
          const options = document.createElement('div');
          options.className = 'oc-panel-options';
          panelData.options.forEach((option) => {
            const item = document.createElement('span');
            item.className = 'oc-panel-option';
            item.textContent = option;
            options.append(item);
          });
          panel.append(options);
        }

        computerFeed.append(panel);
        scrollFeed(computerFeed);
        play(panel, { opacity: [0, 1], y: [6, 0] }, { duration: MOTION.duration.fast, ease: MOTION.ease.out });
        return panel;
      }

      function markPanelChoice(value: string) {
        const panels = computerFeed.querySelectorAll<HTMLElement>('.oc-panel');
        const panel = panels[panels.length - 1];
        if (!panel) return;
        let options = panel.querySelector<HTMLElement>('.oc-panel-options');
        if (!options) {
          options = document.createElement('div');
          options.className = 'oc-panel-options';
          panel.append(options);
        }
        const match = Array.from(options.querySelectorAll<HTMLElement>('.oc-panel-option')).find(
          (option) => option.textContent?.trim() === value,
        );
        if (match) {
          match.classList.add('is-picked');
          return;
        }
        const picked = document.createElement('span');
        picked.className = 'oc-panel-option is-picked';
        picked.textContent = value;
        options.append(picked);
      }

      function addPhoneBot(
        html: string,
        options: { label?: string; actions?: { label: string; value: string }[] },
        myRun: number,
      ) {
        if (!isActive(myRun)) return { el: null, buttons: [] as HTMLButtonElement[] };
        const message = document.createElement('div');
        message.className = 'demo-msg';
        let content = html;
        if (options.actions && options.actions.length > 0) {
          content += `<div class="demo-msg-actions">${options.actions
            .map(
              (action) =>
                `<button type="button" class="demo-msg-btn" data-value="${esc(action.value)}">${esc(action.label)}</button>`,
            )
            .join('')}</div>`;
        }
        content += '<div class="demo-msg-meta"><span>09:41</span></div>';
        message.innerHTML = content;
        const buttons = Array.from(message.querySelectorAll<HTMLButtonElement>('button'));
        phoneFeed.append(message);
        scrollFeed(phoneFeed);
        play(message, { opacity: [0, 1], y: [14, 0], scale: [0.98, 1] }, { duration: MOTION.duration.fast, ease: MOTION.ease.out });
        return { el: message, buttons };
      }

      function addPhoneUser(text: string, myRun: number) {
        if (!isActive(myRun)) return;
        const message = document.createElement('div');
        message.className = 'demo-msg demo-msg--user';
        const body = document.createElement('p');
        body.className = 'demo-msg-body';
        body.textContent = text;
        const meta = document.createElement('div');
        meta.className = 'demo-msg-meta';
        const time = document.createElement('span');
        time.textContent = '09:41';
        const check = document.createElement('span');
        check.className = 'demo-msg-check';
        check.textContent = '✓✓';
        meta.append(time, check);
        message.append(body, meta);
        phoneFeed.append(message);
        scrollFeed(phoneFeed);
        play(message, { opacity: [0, 1], y: [14, 0], scale: [0.98, 1] }, { duration: MOTION.duration.fast, ease: MOTION.ease.out });
      }

      function addPhoneSystem(text: string, myRun: number) {
        if (!isActive(myRun)) return;
        const message = document.createElement('div');
        message.className = 'demo-msg demo-msg--system';
        message.textContent = text;
        phoneFeed.append(message);
        scrollFeed(phoneFeed);
        play(message, { opacity: [0, 1], y: [6, 0] }, { duration: MOTION.duration.fast, ease: MOTION.ease.out });
      }

      async function showTyping(myRun: number, duration = 700) {
        if (!isActive(myRun)) return;
        const message = document.createElement('div');
        message.className = 'demo-msg';
        message.innerHTML = '<span class="demo-typing"><span></span><span></span><span></span></span>';
        phoneFeed.append(message);
        scrollFeed(phoneFeed);
        play(message, { opacity: [0, 1], y: [8, 0] }, { duration: MOTION.duration.fast, ease: MOTION.ease.out });
        await wait(duration);
        if (!isActive(myRun)) {
          message.remove();
          return;
        }
        await playAndWait(message, { opacity: 0, y: -4 }, { duration: 0.15 });
        message.remove();
      }

      function waitForChoice(buttons: HTMLButtonElement[], myRun: number): Promise<string> {
        if (buttons.length === 0) return Promise.resolve('');
        return new Promise((resolve) => {
          buttons.forEach((button) => {
            button.addEventListener(
              'click',
              () => {
                if (!isActive(myRun)) return;
                buttons.forEach((item) => {
                  item.disabled = true;
                });
                button.classList.add('is-picked');
                play(button, { scale: [1, 0.94, 1] }, { duration: 0.18, ease: MOTION.ease.out });
                resolve(button.dataset.value ?? '');
              },
              { once: true },
            );
          });
        });
      }

      function waitForPrompt(): Promise<string> {
        return new Promise((resolve) => {
          pendingPrompt = resolve;
        });
      }

      function submitPrompt() {
        if (!pendingPrompt) return;
        const value = phoneInput.value.trim();
        if (!value) {
          play(phoneInput, { x: [0, -4, 4, -2, 0] }, { duration: 0.25, ease: MOTION.ease.out });
          return;
        }
        const resolve = pendingPrompt;
        pendingPrompt = null;
        phoneSend.classList.remove('is-attention');
        phoneInput.disabled = true;
        phoneSend.disabled = true;
        resolve(value);
      }

      phoneSend.addEventListener('click', submitPrompt);
      phoneInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          submitPrompt();
        }
      });

      function waitForCommandSelection(myRun: number): Promise<string> {
        return new Promise((resolve) => {
          pendingCommandSelection = (id) => {
            if (isActive(myRun)) resolve(id);
          };
        });
      }

      async function playBotCommand(id: string, myRun: number) {
        const command = COMMANDS[id];
        if (!command || !isActive(myRun)) return;

        addPhoneUser(command.command, myRun);
        await wait(250);
        if (!isActive(myRun)) return;
        await showTyping(myRun, 550);
        if (!isActive(myRun)) return;

        let html = command.html;
        let actions = command.actions;
        if (id === 'session') {
          html = '<p class="demo-msg-title">Recent sessions</p><p class="demo-msg-body">Tap a session to bind it.</p>';
          actions = SESSIONS.map((session) => ({
            label: `${boundSession === session.title ? '✓ ' : ''}${session.title}`,
            value: session.title,
          }));
        }

        const { buttons } = addPhoneBot(html, { actions }, myRun);
        if (!actions || actions.length === 0) return;

        buttons.forEach((button) => {
          button.addEventListener(
            'click',
            () => {
              if (!isActive(myRun)) return;
              buttons.forEach((item) => {
                item.disabled = true;
              });
              button.classList.add('is-picked');
              const label = (button.textContent ?? '').replace('✓ ', '').trim();
              const value = button.dataset.value ?? '';
              if (id === 'session') boundSession = label;
              if (id === 'exit' && value === 'stop daemon') stopDaemon();
              const followUp = command.followUp?.(label, value) ?? '';
              if (!followUp) return;
              void (async () => {
                await wait(220);
                if (!isActive(myRun)) return;
                addPhoneBot(`<p class="demo-msg-body">${esc(followUp)}</p>`, {}, myRun);
              })();
            },
            { once: true },
          );
        });
      }

      function handleCommandSelection(id: string) {
        if (!COMMANDS[id]) return;
        setCommandMenu(false);
        const myRun = runId;
        if (pendingCommandSelection) {
          const resolve = pendingCommandSelection;
          pendingCommandSelection = null;
          resolve(id);
          return;
        }
        void playBotCommand(id, myRun);
      }

      function stopDaemon() {
        daemonStopped = true;
        commandMenuBtn.disabled = true;
        commandMenuBtn.classList.remove('is-attention');
        setCommandMenu(false, false);
        setResetTooltip(true);
        setComputerStatus('idle', 'daemon stopped');
        setStageStatus('idle', 'daemon stopped');
        resetDemoBtn.focus();
      }

      function resetDemo() {
        daemonStopped = false;
        commandsHintShown = false;
        commandMenuBtn.disabled = false;
        setResetTooltip(false);
        void runScenario('commands', true);
        commandMenuBtn.focus();
      }

      async function playCommands(myRun: number) {
        if (daemonStopped) {
          setComputerStatus('idle', 'daemon stopped');
          setStageStatus('idle', 'daemon stopped');
          addComputerLine('status', 'daemon stopped · reset the demo to continue', myRun, { instant: true });
          commandMenuBtn.disabled = true;
          setResetTooltip(true);
          resetDemoBtn.focus();
          return;
        }

        setComputerStatus('idle', 'session idle');
        setStageStatus('waiting', 'waiting for you');
        addComputerLine('status', 'session idle · waiting for a Telegram command', myRun, { instant: true });

        if (!commandsHintShown) {
          commandsHintShown = true;
          commandMenuBtn.classList.add('is-attention');
        }

        const commandId = await waitForCommandSelection(myRun);
        if (!isActive(myRun)) return;

        setStageStatus('live', 'working');
        await playBotCommand(commandId, myRun);
        if (!isActive(myRun)) return;
        setComputerStatus('idle', daemonStopped ? 'daemon stopped' : 'session idle');
        setStageStatus(daemonStopped ? 'idle' : 'done', daemonStopped ? 'daemon stopped' : 'complete');
      }

      async function playFinished(myRun: number) {
        setComputerStatus('live', 'session running');
        await wait(350);
        if (!isActive(myRun)) return;
        addComputerLine('user', 'Refactor the sidebar state and run the checks.', myRun);
        await wait(450);
        if (!isActive(myRun)) return;
        addComputerLine('assistant', 'Done. I moved the state out of the route component, updated the call sites, and ran the checks.', myRun, { type: true });
        await wait(900);
        if (!isActive(myRun)) return;
        addComputerTool('cargo test', '✓ 148 passed', myRun);
        await wait(450);
        if (!isActive(myRun)) return;
        addComputerLine('status', 'session finished · 2m 14s', myRun);
        setComputerStatus('done', 'session finished');
        showNotification('Session finished', 'Refactor the sidebar state — 2m 14s');
        await wait(400);
        if (!isActive(myRun)) return;
        await showTyping(myRun, 650);
        if (!isActive(myRun)) return;
        addPhoneBot(
          `<p class="demo-msg-title">Session finished</p><p class="demo-msg-body">2m 14s · postal-ui</p><p class="demo-msg-body">Moved the sidebar state out of the route component. 148 tests pass.</p>`,
          { label: 'opencode-telegram' },
          myRun,
        );
      }

      async function playQuestion(myRun: number) {
        setComputerStatus('live', 'session running');
        await wait(300);
        if (!isActive(myRun)) return;
        addComputerLine('user', 'Add a test for the mute @all setting.', myRun);
        await wait(400);
        if (!isActive(myRun)) return;
        addComputerLine('assistant', 'I need one decision before I write the migration.', myRun, { type: true });
        await wait(850);
        if (!isActive(myRun)) return;
        addComputerPanel(
          {
            label: 'QUESTION',
            title: 'Where should the mute preference live?',
            options: ['chat_settings', 'global settings', 'both'],
          },
          myRun,
        );
        setComputerStatus('waiting', 'waiting for you');
        setStageStatus('waiting', 'waiting for you');
        showNotification('Agent has a question', 'Where should the mute preference live?');
        await wait(400);
        if (!isActive(myRun)) return;
        await showTyping(myRun, 600);
        if (!isActive(myRun)) return;
        const { buttons } = addPhoneBot(
          `<p class="demo-msg-title">I need one decision before I write the migration.</p><p class="demo-msg-body">Where should the mute preference live?</p>`,
          {
            label: 'opencode-telegram',
            actions: [
              { label: 'chat_settings', value: 'chat_settings' },
              { label: 'global settings', value: 'global settings' },
              { label: 'both', value: 'both' },
            ],
          },
          myRun,
        );
        const choice = await waitForChoice(buttons, myRun);
        if (!isActive(myRun)) return;
        addPhoneUser(choice, myRun);
        markPanelChoice(choice);
        setComputerStatus('live', 'session running');
        setStageStatus('live', 'working');
        await wait(250);
        if (!isActive(myRun)) return;
        addComputerLine('assistant', `Using ${choice}. Writing the migration now.`, myRun, { type: true });
        await wait(750);
        if (!isActive(myRun)) return;
        addComputerTool('cargo test', '✓ 3 tests added · 151 passed', myRun);
        await wait(350);
        if (!isActive(myRun)) return;
        addComputerLine('status', 'session finished · 1m 42s', myRun);
        setComputerStatus('done', 'session finished');
        showNotification('Session finished', `Migration added — ${choice}`);
        await wait(350);
        if (!isActive(myRun)) return;
        addPhoneBot(
          `<p class="demo-msg-title">Done.</p><p class="demo-msg-body">Using <code>${esc(choice)}</code>. Migration added and 151 tests pass.</p>`,
          {},
          myRun,
        );
      }

      async function playPermission(myRun: number): Promise<boolean> {
        setComputerStatus('live', 'session running');
        await wait(300);
        if (!isActive(myRun)) return false;
        addComputerLine('user', 'Push the fix to the branch.', myRun);
        await wait(400);
        if (!isActive(myRun)) return false;
        addComputerLine('assistant', 'The fix is committed. I need permission to push.', myRun, { type: true });
        await wait(850);
        if (!isActive(myRun)) return false;
        addComputerPanel(
          { label: 'PERMISSION', title: 'Allow this command?', code: 'git push origin fix/sidebar-state' },
          myRun,
        );
        setComputerStatus('waiting', 'waiting for you');
        setStageStatus('waiting', 'waiting for you');
        showNotification('Permission requested', 'git push origin fix/sidebar-state');
        await wait(400);
        if (!isActive(myRun)) return false;
        await showTyping(myRun, 600);
        if (!isActive(myRun)) return false;
        const { buttons } = addPhoneBot(
          `<p class="demo-msg-title">Permission requested</p><p class="demo-msg-body">I want to run:</p><code class="demo-msg-code">git push origin fix/sidebar-state</code>`,
          {
            label: 'opencode-telegram',
            actions: [
              { label: 'Approve', value: 'approve' },
              { label: 'Deny', value: 'deny' },
            ],
          },
          myRun,
        );
        const choice = await waitForChoice(buttons, myRun);
        if (!isActive(myRun)) return false;

        if (choice === 'approve') {
          addPhoneUser('Approved', myRun);
          markPanelChoice('approved by telegram');
          setComputerStatus('live', 'session running');
          setStageStatus('live', 'working');
          await wait(250);
          if (!isActive(myRun)) return false;
          addComputerLine('assistant', 'Permission granted. Pushing now.', myRun, { type: true });
          await wait(550);
          if (!isActive(myRun)) return false;
          addComputerTool('git push origin fix/sidebar-state', '✓ pushed · 12 files', myRun);
          await wait(350);
          if (!isActive(myRun)) return false;
          addComputerLine('status', 'session finished · 38s', myRun);
          setComputerStatus('done', 'session finished');
          showNotification('Session finished', 'Pushed fix/sidebar-state — 12 files');
          await wait(350);
          if (!isActive(myRun)) return false;
          addPhoneBot(
            `<p class="demo-msg-title">Pushed.</p><p class="demo-msg-body">fix/sidebar-state is up to date. Session finished in 38s.</p>`,
            {},
            myRun,
          );
          return true;
        } else {
          addPhoneUser('Denied', myRun);
          markPanelChoice('denied by telegram');
          setComputerStatus('idle', 'session stopped');
          setStageStatus('idle', 'stopped');
          await wait(250);
          if (!isActive(myRun)) return false;
          addComputerLine('assistant', 'Understood. I will not push. The session is stopped.', myRun, { type: true });
          await wait(600);
          if (!isActive(myRun)) return false;
          addComputerLine('status', 'permission denied · session stopped', myRun);
          await showTyping(myRun, 500);
          if (!isActive(myRun)) return false;
          addPhoneBot(
            `<p class="demo-msg-title">Denied.</p><p class="demo-msg-body">Understood. I won't push. The session is stopped.</p>`,
            {},
            myRun,
          );
          return false;
        }
      }

      async function playPrompt(myRun: number) {
        setComputerStatus('idle', 'waiting for a prompt');
        setStageStatus('waiting', 'waiting for you');
        addComputerLine('status', 'waiting for a prompt from Telegram', myRun, { instant: true });
        setComposer(true, 'Run the tests and fix any failures.', true);
        phoneSend.classList.add('is-attention');
        await wait(300);
        if (!isActive(myRun)) return;
        const prompt = await waitForPrompt();
        if (!isActive(myRun)) return;
        addPhoneUser(prompt, myRun);
        setComposer(false);
        setComputerStatus('live', 'session running');
        setStageStatus('live', 'working');
        await wait(250);
        if (!isActive(myRun)) return;
        addComputerLine('user', prompt, myRun);
        await wait(400);
        if (!isActive(myRun)) return;
        addComputerLine('assistant', 'On it. Running the test suite first.', myRun, { type: true });
        await wait(700);
        if (!isActive(myRun)) return;
        addComputerTool('cargo test', '✕ 2 failed', myRun, true);
        await wait(500);
        if (!isActive(myRun)) return;
        addComputerLine('assistant', 'Two assertions expect the old sidebar behavior. Updating them now.', myRun, { type: true });
        await wait(850);
        if (!isActive(myRun)) return;
        addComputerTool('cargo test', '✓ 148 passed', myRun);
        await wait(350);
        if (!isActive(myRun)) return;
        addComputerLine('status', 'session finished · 1m 08s', myRun);
        setComputerStatus('done', 'session finished');
        showNotification('Session finished', 'Tests fixed — 148 passed');
        await wait(350);
        if (!isActive(myRun)) return;
        addPhoneBot(
          `<p class="demo-msg-title">All green.</p><p class="demo-msg-body">Fixed two stale assertions. 148 tests pass. Session finished in 1m 08s.</p>`,
          {},
          myRun,
        );
      }

      async function runScenario(id: string, initial = false) {
        started = true;
        currentScenario = id;
        const myRun = ++runId;
        const activeButton = scenarioButtons.find((button) => button.dataset.scenario === id);
        scenarioButtons.forEach((button) => {
          const active = button === activeButton;
          button.dataset.active = String(active);
          button.setAttribute('aria-pressed', String(active));
        });

        const number = activeButton?.querySelector('.demo-scenario-number')?.textContent ?? '01';
        const label = activeButton?.querySelector('.demo-scenario-title')?.textContent ?? id;
        caption.textContent = `${number} / ${label}`;

        if (!initial) {
          const rect = stage.getBoundingClientRect();
          if (rect.top < 80 || rect.bottom > window.innerHeight) {
            stage.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          }
        }

        resetStage();
        if (!initial) {
          play(computerFeed, { opacity: [0.35, 1], y: [4, 0] }, { duration: 0.25, ease: MOTION.ease.out });
          play(phoneFeed, { opacity: [0.35, 1], y: [4, 0] }, { duration: 0.25, ease: MOTION.ease.out });
        }
        setStageStatus('live', 'running');
        await wait(initial ? 450 : 220);
        if (!isActive(myRun)) return;

        addComputerLine('status', 'session postal-ui · connected', myRun, { instant: true });
        addPhoneSystem('connected · listening for events', myRun);

        let endTone = 'done';
        let endLabel = 'complete';

        switch (id) {
          case 'question':
            await playQuestion(myRun);
            break;
          case 'permission': {
            const approved = await playPermission(myRun);
            if (!approved) {
              endTone = 'idle';
              endLabel = 'stopped';
            }
            break;
          }
          case 'prompt':
            await playPrompt(myRun);
            break;
          case 'commands':
            await playCommands(myRun);
            break;
          case 'finished':
          default:
            await playFinished(myRun);
            break;
        }

        if (isActive(myRun)) {
          if (daemonStopped) setStageStatus('idle', 'daemon stopped');
          else setStageStatus(endTone, endLabel);
        }
      }

      commandMenuBtn.addEventListener('click', () => {
        if (commandMenuBtn.disabled) return;
        commandMenuBtn.classList.remove('is-attention');
        setCommandMenu(!commandMenuOpen);
      });

      resetDemoBtn.addEventListener('click', resetDemo);

      commandClose.addEventListener('click', () => {
        setCommandMenu(false);
      });

      commandBackdrop.addEventListener('click', () => {
        setCommandMenu(false);
      });

      commandItems.forEach((item) => {
        item.addEventListener('click', () => {
          const id = item.dataset.command;
          if (id) handleCommandSelection(id);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && commandMenuOpen) {
          event.preventDefault();
          setCommandMenu(false);
        }
      });

      scenarioButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.scenario;
          if (id) void runScenario(id);
        });
      });

      replay.addEventListener('click', () => {
        void runScenario(currentScenario);
      });

      inView(
        stage,
        () => {
          if (started) return;
          started = true;
          void runScenario('finished', true);
        },
        { margin: MOTION.viewport.margin },
      );
  </script>
