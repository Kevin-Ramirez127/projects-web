---
// Official OpenCode logo (light), from the OpenCode brand assets.
interface Props {
  class?: string;
  idPrefix?: string;
}

const { class: className = '', idPrefix = 'opencode-logo' } = Astro.props;
const clipId = `${idPrefix}-clip`;
const maskId = `${idPrefix}-mask`;
---
<svg
  class={className}
  width="240"
  height="300"
  viewBox="0 0 240 300"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="OpenCode"
>
  <title>OpenCode</title>
  <g clip-path={`url(#${clipId})`}>
    <mask id={maskId} style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="240" height="300">
      <path d="M240 0H0V300H240V0Z" fill="white" />
    </mask>
    <g mask={`url(#${maskId})`}>
      <path d="M180 240H60V120H180V240Z" fill="#D2D2D2" />
      <path d="M180 60H60V240H180V60ZM240 300H0V0H240V300Z" fill="#1F1F1F" />
    </g>
  </g>
  <defs>
    <clipPath id={clipId}>
      <rect width="240" height="300" fill="white" />
    </clipPath>
  </defs>
</svg>
