---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../lib/site';
---
<header class="fixed top-0 inset-x-0 z-40 bg-ink/95">
  <div class="mx-auto max-w-6xl px-6 md:px-10 h-20 flex items-center justify-between">
    <ThemeToggle />
    <div class="flex items-center gap-4 sm:gap-7">
      <a href={site.social.portfolio} target="_blank" rel="noreferrer" aria-label="Open the main site, ramirezkevin.dev" class="bracket-link whitespace-nowrap text-xs md:text-sm font-light">
        <span class="br">[</span><span class="sm:hidden">main site</span><span class="hidden sm:inline">ramirezkevin.dev</span><span aria-hidden="true">↗</span><span class="br">]</span>
        <span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span class="sm:hidden">main site</span><span class="hidden sm:inline">ramirezkevin.dev</span><span>↗</span><span class="br">]</span></span>
      </a>
      <span class="w-[5em] shrink-0 flex justify-start">
        <button id="menu-btn" aria-expanded="false" aria-controls="menu-overlay" class="bracket-link text-xl md:text-2xl font-light cursor-pointer">
          <span class="br">[</span><span>menu</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>menu</span><span class="br">]</span></span>
        </button>
      </span>
    </div>
  </div>
</header>

<div id="menu-overlay" role="dialog" aria-modal="true" aria-label="Site menu" inert class="fixed inset-0 z-50 bg-ink pointer-events-none opacity-0">
  <div class="relative h-full mx-auto max-w-6xl px-6 md:px-10 flex flex-col">
    <div class="h-20 shrink-0 flex items-center justify-between">
      <ThemeToggle />
      <span class="w-[5em] shrink-0 flex justify-start"><button id="menu-close" class="bracket-link text-xl md:text-2xl cursor-pointer">
        <span class="br">[</span><span>close</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>close</span><span class="br">]</span></span>
      </button></span>
    </div>
    <nav aria-label="Primary" class="flex-1 flex flex-col justify-center gap-2 md:gap-3">
      <a data-menu-link href="/" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="font-matrix text-[11px] tracking-[0.25em] text-bone-faint">01</span>
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Projects</span>
      </a>
      <a data-menu-link href="/#projects" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="font-matrix text-[11px] tracking-[0.25em] text-bone-faint">02</span>
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Main projects</span>
      </a>
      <a data-menu-link href="/#contributions" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="font-matrix text-[11px] tracking-[0.25em] text-bone-faint">03</span>
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Open source</span>
      </a>
      <a data-menu-link href="/#contact" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="font-matrix text-[11px] tracking-[0.25em] text-bone-faint">04</span>
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Elsewhere</span>
      </a>
    </nav>
    <div class="pb-10 flex flex-wrap gap-6 font-matrix text-sm text-bone-faint">
      <span>Montevideo, Uruguay</span>
      <a class="text-accent hover:text-bone transition" href="https://github.com/Kevin-Ramirez127" target="_blank" rel="noreferrer">[ GitHub ]</a>
      <a class="text-accent hover:text-bone transition" href="https://www.linkedin.com/in/kevin-ramirez-silva/" target="_blank" rel="noreferrer">[ LinkedIn ]</a>
      <a class="text-accent hover:text-bone transition" href={site.social.portfolio} target="_blank" rel="noreferrer">[ Main site ]</a>
    </div>
  </div>
</div>
